{
  "name": "cloudpulse-devops-platform",
  "version": "1.0.0",
  "description": "Cloud & DevOps Capstone: Enterprise Cloud Infrastructure & Incident Management SaaS with Docker, CI/CD, and Observability",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "lint": "node -c server.js src/**/*.js tests/**/*.js",
    "docker:build": "docker build -t cloudpulse-app:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env cloudpulse-app:latest",
    "compose:up": "docker-compose up -d --build",
    "compose:down": "docker-compose down -v"
  },
  "keywords": [
    "cloud",
    "devops",
    "capstone",
    "docker",
    "kubernetes",
    "ci-cd",
    "github-actions",
    "prometheus",
    "grafana",
    "monitoring",
    "postgresql",
    "saas"
  ],
  "author": "MUTHUKRISHNAN K",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "prom-client": "^15.1.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
