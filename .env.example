# ==============================================================================
# CloudPulse - Environment Configuration Template
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
APP_NAME=cloudpulse-devops-platform
APP_VERSION=1.0.0
BUILD_ID=local-build-v1.0.0

# Authentication & Security
# NOTE: Replace with a strong random string in production!
JWT_SECRET=devops_capstone_jwt_super_secret_key_2026_xyz987
JWT_EXPIRY=24h

# Managed Database Connection (PostgreSQL)
# For local docker-compose: postgres://cloudpulse_user:cloudpulse_pass@db:5432/cloudpulse_db
# When running on Render / Supabase / Neon, replace with your cloud connection string.
# If left empty, CloudPulse automatically activates a zero-config in-memory fallback.
DATABASE_URL=postgres://cloudpulse_user:cloudpulse_pass@localhost:5432/cloudpulse_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Telemetry & Observability
METRICS_ENABLED=true
METRICS_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*
