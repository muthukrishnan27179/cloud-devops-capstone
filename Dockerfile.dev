# ==============================================================================
# CloudPulse - Local Development Dockerfile (Hot Reloading)
# ==============================================================================

FROM node:20-alpine

WORKDIR /usr/src/app

# Install nodemon globally for hot reloading
RUN npm install -g nodemon

COPY package*.json ./
RUN npm install

COPY . .

ENV NODE_ENV=development \
    PORT=3000

EXPOSE 3000

CMD ["nodemon", "server.js"]
